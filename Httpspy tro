-- 13. الحماية عبر metatable (طبقة واحدة موحّدة)
-- ============================================================
pcall(function()
    if type(ORI.getrawmetatable) ~= "function" then return end
    local mt = ORI.getrawmetatable(game)
    if not mt then return end
    
    if type(ORI.setreadonly) == "function" then
        pcall(ORI.setreadonly, mt, false)
    end
    
    local origIndex = mt.__index
    local origNamecall = mt.__namecall
    
    -- __index موحّد
    mt.__index = protectFunc(function(self, key)
        -- إخفاء اسم وكلاس الواجهة
        if (self == screenGui or self == container) and key == "Name" then
            return "ConfigService"
        end
        if (self == screenGui or self == container) and key == "ClassName" then
            return "Folder"
        end
        -- إخفاء متغيراتنا عن _G
        if type(key) == "string" and key:sub(1, 4) == "_SYS" then
            return nil
        end
        return origIndex(self, key)
    end)
    
    -- __namecall موحّد
    mt.__namecall = protectFunc(function(self, ...)
        local method = "unknown"
        if type(ORI.getnamecallmethod) == "function" then
            local ok, m = pcall(ORI.getnamecallmethod)
            if ok then method = m end
        end
        
        -- منع Destroy
        if method == "Destroy" and (self == screenGui or self == container) then
            return nil
        end
        
        -- منع FindFirstChild / WaitForChild
        if method == "FindFirstChild" or method == "WaitForChild" or method == "FindFirstChildOfClass" then
            local args = {...}
            local name = args[1]
            if type(name) == "string" then
                local lower = string.lower(name)
                if lower:find("sniffer", 1, true) or lower:find("spy", 1, true)
                    or lower:find("intercept", 1, true) or lower:find("phantom", 1, true)
                    or lower:find("_c", 1, true) or lower:find("_lg", 1, true) then
                    if method == "WaitForChild" then
                        return Instance.new("Folder")
                    end
                    return nil
                end
            end
        end
        
        -- إخفاء المجلد عن GetChildren
        if method == "GetChildren" or method == "GetDescendants" then
            if self == parent then
                local kids = origNamecall(self, ...)
                local filtered = {}
                for _, k in ipairs(kids) do
                    if k ~= container then
                        filtered[#filtered + 1] = k
                    end
                end
                return filtered
            end
            if self == container then
                return {}
            end
        end
        
        return origNamecall(self, ...)
    end)
    
    if type(ORI.setreadonly) == "function" then
        pcall(ORI.setreadonly, mt, true)
    end
end)

