-- ============================================================
-- 8. حماية getgc
-- ============================================================
if type(ORI.getgc) == "function" then
    local wrapper = protectFunc(function(...)
        local ok, list = pcall(ORI.getgc, ...)
        if not ok or type(list) ~= "table" then return list end
        local out = {}
        for i = 1, #list do
            if not SG.banned[list[i]] then
                out[#out + 1] = list[i]
            end
        end
        return out
    end)
    _ENV.getgc = wrapper
    SG.hooks.getgc = wrapper
end

-- ============================================================
-- 9. حماية getreg
-- ============================================================
if type(ORI.getreg) == "function" then
    local wrapper = protectFunc(function()
        local ok, reg = pcall(ORI.getreg)
        if not ok or type(reg) ~= "table" then return reg end
        local clean = {}
        for k, v in pairs(reg) do
            if v ~= SG and v ~= _ENV._SYSGUARD then
                clean[k] = v
            end
        end
        return clean
    end)
    _ENV.getreg = wrapper
    SG.hooks.getreg = wrapper
end

-- ============================================================
-- 10. حماية getconnections
-- ============================================================
if type(ORI.getconnections) == "function" then
    local wrapper = protectFunc(function(obj)
        if SG.protected[obj] then return {} end
        local ok, result = pcall(ORI.getconnections, obj)
        if ok then return result end
        return {}
    end)
    _ENV.getconnections = wrapper
    SG.hooks.getconnections = wrapper
end

