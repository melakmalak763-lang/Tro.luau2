local function tagURL(url)
    local lower = string.lower(tostring(url))
    if lower:find("github", 1, true) then return "GITHUB"
    elseif lower:find("pastebin", 1, true) then return "PASTEBIN"
    elseif lower:find("pastefy", 1, true) then return "PASTEFY"
    elseif lower:find("raw", 1, true) then return "RAW"
    elseif lower:find("http", 1, true) then return "HTTP"
    end
    return "REQ"
end

-- اعتراض loadstring
pcall(function()
    if type(ORI.loadstring) ~= "function" then return end
    
    local wrapper = protectFunc(function(code, chunk)
        local a, b = ORI.loadstring(code, chunk)
        QueueLog("LOADSTRING", chunk or "Source", code)
        return a, b
    end)
    
    _ENV.loadstring = wrapper
    SG.hooks.loadstring = wrapper
    SG.protectedFuncs[wrapper] = true
end)

-- اعتراض request
pcall(function()
    if type(ORI.request) ~= "function" then return end
    if type(ORI.hookfunction) ~= "function" then return end
    
    local wrapper = protectFunc(function(t)
        local ok, res = pcall(ORI.request, t)
        if ok and res then
            local u = type(t) == "table" and (t.Url or t.url or t.URL) or "API"
            local b = type(res) == "table" and (res.Body or res.body) or tostring(res)
            QueueLog(tagURL(u), u, b)
        end
        if not ok then error(res, 0) end
        return res
    end)
    
    ORI.hookfunction(ORI.request, wrapper)
    SG.hooks.request = wrapper
    SG.protectedFuncs[wrapper] = true
end)

-- اعتراض HttpGet
pcall(function()
    if type(game.HttpGet) ~= "function" then return end
    if type(ORI.hookfunction) ~= "function" then return end
    
    local rawHttpGet = game.HttpGet
    local wrapper = protectFunc(function(self, url, ...)
        local res = rawHttpGet(self, url, ...)
        QueueLog(tagURL(url), url, res)
        return res
    end)
    
    ORI.hookfunction(game.HttpGet, wrapper)
    SG.hooks.HttpGet = wrapper
    SG.protectedFuncs[wrapper] = true
end)

