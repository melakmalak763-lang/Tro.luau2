-- 6. دالة الحماية (تتحقق من وجود newcclosure)
local function protectFunc(f)
    if type(_ENV.newcclosure) == "function" then
        local ok, result = pcall(_ENV.newcclosure, f)
        if ok and result then return result end
    end
    return f
end

