-- 11. حماية getupvalue / getconstants
-- ============================================================
local function protectDumpFunc(name)
    local original = _ENV[name]
    if type(original) ~= "function" then return end
    local wrapper = protectFunc(function(f, ...)
        if SG.protectedFuncs[f] then return nil end
        return original(f, ...)
    end)
    _ENV[name] = wrapper
    if _ENV.debug and _ENV.debug[name] then
        _ENV.debug[name] = wrapper
    end
end

protectDumpFunc("getupvalue")
protectDumpFunc("getconstants")

