local Hashes = {}
local LogsList = {}
local Counter = 0
local MAX_LOGS = 100
local pending = {}
local processing = false

local function AddLog(tag, url, content)
    if not SG.alive then return end
    
    -- إزالة الأقدم إذا وصلنا الحد
    if Counter >= MAX_LOGS and #LogsList > 0 then
        local old = table.remove(LogsList, 1)
        pcall(function() old:Destroy() end)
        Counter = Counter - 1
    end
    
    local str = tostring(content)
    if #str < 8 then return end
    
    -- بصمة فريدة
    local key = #str .. "|" .. str:sub(1, 24)
    if Hashes[key] then return end
    Hashes[key] = true
    Counter = Counter + 1
    
    -- زر السجل
    local Btn = Instance.new("TextButton", Scroll)
    Btn.Size = UDim2.new(1, -4, 0, 42)
    Btn.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    Btn.BorderColor3 = Color3.fromRGB(70, 70, 70)
    Btn.BorderSizePixel = 1
    Btn.Text = ""
    Btn.LayoutOrder = Counter
    SG.banned[Btn] = true
    
    local btnCorner = Instance.new("UICorner", Btn)
    btnCorner.CornerRadius = UDim.new(0, 4)
    
    -- النص الأول (الوسم)
    local L1 = Instance.new("TextLabel", Btn)
    L1.Size = UDim2.new(1, -8, 0, 16)
    L1.Position = UDim2.new(0, 4, 0, 3)
    L1.BackgroundTransparency = 1
    L1.Text = "[" .. tostring(tag) .. "]"
    L1.TextColor3 = Color3.fromRGB(255, 255, 255)
    L1.TextSize = 10
    L1.Font = Enum.Font.Code
    L1.TextXAlignment = Enum.TextXAlignment.Left
    SG.banned[L1] = true
    
    -- النص الثاني (الرابط)
    local L2 = Instance.new("TextLabel", Btn)
    L2.Size = UDim2.new(1, -8, 0, 16)
    L2.Position = UDim2.new(0, 4, 0, 20)
    L2.BackgroundTransparency = 1
    L2.Text = tostring(url)
    L2.TextColor3 = Color3.fromRGB(150, 150, 150)
    L2.TextSize = 9
    L2.Font = Enum.Font.Code
    L2.TextXAlignment = Enum.TextXAlignment.Left
    L2.TextTruncate = Enum.TextTruncate.AtEnd
    SG.banned[L2] = true
    
    -- عند الضغط
    Btn.MouseButton1Click:Connect(function()
        Box.Text = "[" .. tostring(tag) .. "] " .. tostring(url) .. "\n\n" .. str
    end)
    
    table.insert(LogsList, Btn)
    Scroll.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 8)
end

local function QueueLog(tag, url, content)
    if #pending > 200 then return end
    table.insert(pending, {tag, url, content})
    
    if processing then return end
    processing = true
    
    task.spawn(function()
        while #pending > 0 and SG.alive do
            local item = table.remove(pending, 1)
            pcall(AddLog, item[1], item[2], item[3])
            task.wait()
        end
        processing = false
    end)
end

